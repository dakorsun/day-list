{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./src",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@components/*": ["app/components/*"],
      "@pages/*": ["app/pages/*"],
      "@state/*": ["app/state/*"],
      "@spartan-ng/helm/button": [
        "./src/app/components/ui/ui-button-helm/src/index.ts"
      ],
      "@spartan-ng/helm/card": [
        "./src/app/components/ui/ui-card-helm/src/index.ts"
      ],
      "@spartan-ng/helm/form-field": [
        "./src/app/components/ui/ui-form-field-helm/src/index.ts"
      ],
      "@spartan-ng/helm/input": [
        "./src/app/components/ui/ui-input-helm/src/index.ts"
      ],
      "@spartan-ng/helm/label": [
        "./src/app/components/ui/ui-label-helm/src/index.ts"
      ],
      "@spartan-ng/helm/typography": [
        "./src/app/components/ui/ui-typography-helm/src/index.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
